t.TextView" package="dev.sopho.suofei" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[137,389][944,435]" /><node index="4" text="行行重行行，与君生别离。" resource-id="" class="android.widget.TextView" package="dev.sopho.suofei" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[137,523][944,587]" /><node index="5" text="相去万余里，各在天一涯。" resource-id="" class="android.widget.TextView" package="dev.sopho.suofei" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[137,587][944,651]" /><node index="6" text="道路阻且长，会面安可知？" resource-id="" class="android.widget.TextView" package="dev.sopho.suofei" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[137,651][944,715]" /><node index="7" text="胡马依北风，越鸟巢南枝。" resource-id="" class="android.widget.TextView" package="dev.sopho.suofei" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[137,715][944,779]" /><node index="8" text="相去日已远，衣带日已缓。" resource-id="" class="android.widget.TextView" package="dev.sopho.suofei" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[137,779][944,843]" /><node index="9" text="浮云蔽白日，游子不顾反。" resource-id="" class="android.widget.