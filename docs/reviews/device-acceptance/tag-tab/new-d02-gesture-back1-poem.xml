t.TextView" package="dev.sopho.suofei" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[137,389][944,435]" /><node index="4" text="冉冉孤生竹，结根泰山阿。" resource-id="" class="android.widget.TextView" package="dev.sopho.suofei" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[137,523][944,587]" /><node index="5" text="与君为新婚，兔丝附女萝。" resource-id="" class="android.widget.TextView" package="dev.sopho.suofei" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[137,587][944,651]" /><node index="6" text="兔丝生有时，夫妇会有宜。" resource-id="" class="android.widget.TextView" package="dev.sopho.suofei" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[137,651][944,715]" /><node index="7" text="千里远结婚，悠悠隔山陂。" resource-id="" class="android.widget.TextView" package="dev.sopho.suofei" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[137,715][944,779]" /><node index="8" text="思君令人老，轩车来何迟？" resource-id="" class="android.widget.TextView" package="dev.sopho.suofei" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[137,779][944,843]" /><node index="9" text="伤彼蕙兰花，含英扬光辉。" resource-id="" class="android.widget.