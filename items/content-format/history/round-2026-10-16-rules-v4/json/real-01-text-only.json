    {
      "id": "real-01-text-only",
      "title": "行行重行行",
      "author": "佚名",
      "dynasty": "汉",
      "genre": "五言古诗",
      "orderInSource": 1,
      "detail": null,
      "stanzas": [
        [
          "行行重行行，与君生别离。",
          "相去万余里，各在天一涯。",
          "道路阻且长，会面安可知？",
          "胡马依北风，越鸟巢南枝。",
          "相去日已远，衣带日已缓。",
          "浮云蔽白日，游子不顾反。",
          "思君令人老，岁月忽已晚。",
          "弃捐勿复道，努力加餐饭。"
        ]
      ],
      "notes": null
    }
  ]
}
